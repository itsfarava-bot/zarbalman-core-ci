{
  "name": "zarbalman/core-test-environment",
  "description": "CI and review environment",
  "type": "project",
  "license": "proprietary",
  "require-dev": {
    "phpunit/phpunit": "9.6.31",
    "squizlabs/php_codesniffer": "3.13.3",
    "wp-coding-standards/wpcs": "3.2.0",
    "phpstan/phpstan": "2.1.17",
    "php-stubs/wordpress-stubs": "7.1.2",
    "php-stubs/woocommerce-stubs": "10.9.4",
    "szepeviktor/phpstan-wordpress": "2.0.4",
    "php-stubs/generator": "0.9.0",
    "phpcompatibility/phpcompatibility-wp": "2.1.8"
  },
  "config": {
    "platform": {
      "php": "8.2.34"
    },
    "allow-plugins": false
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "style": "phpcs --standard=phpcs.xml",
    "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress"
  }
}
